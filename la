-- พิกัดวาร์ปเกาะต่างๆ (Sea 1)
local Islands = {
    ["Starter Island"] = CFrame.new(1059, 16, 1548),
    ["Jungle"] = CFrame.new(-1610, 36, 140),
    ["Pirate Village"] = CFrame.new(-1181, 4, 3820),
    ["Desert"] = CFrame.new(1094, 6, 4192),
    ["Middle Town"] = CFrame.new(-690, 15, 1582),
    ["Frozen Village"] = CFrame.new(1147, 27, -1206),
    ["Marine Ford"] = CFrame.new(-5036, 20, 4323)
}

local function GetCurrentQuest()
    local MyLevel = LocalPlayer.Data.Level.Value
    local CurrentQuestData = LevelData[1]
    for level, data in pairs(LevelData) do
        if MyLevel >= level then
            CurrentQuestData = data
        end
    end
    return CurrentQuestData
end

-- ฟังก์ชันถืออาวุธ
local function EquipWeapon(WeaponType)
    for _, item in pairs(LocalPlayer.Backpack:GetChildren()) do
        if item:IsA("Tool") then
            if (WeaponType == "Melee" and item.ToolTip == "Melee") or
               (WeaponType == "Sword" and item.ToolTip == "Sword") or
               (WeaponType == "Blox Fruit" and item.ToolTip == "Blox Fruit") then
                LocalPlayer.Character.Humanoid:EquipTool(item)
            end
        end
    end
end

-- ฟังก์ชันคลิกตีอัตโนมัติ
local function AutoClick()
    VirtualUser:CaptureController()
    VirtualUser:ClickButton1(Vector2.new(50, 50))
end

-- ==================== TAB 1: MAIN ====================
getgenv().AutoFarm = false
getgenv().SelectWeapon = "Melee"

Tabs.Main:AddDropdown("WeaponSelect", {
    Title = "Select Weapon",
    Values = {"Melee", "Sword", "Blox Fruit"},
    Multi = false,
    Default = 1,
    Callback = function(Value)
        getgenv().SelectWeapon = Value
    end
})

local ToggleFarm = Tabs.Main:AddToggle("AutoFarm", {Title = "Auto Farm Level", Default = false})
ToggleFarm:OnChanged(function()
    getgenv().AutoFarm = Options.AutoFarm.Value
    task.spawn(function()
        while getgenv().AutoFarm do
            task.wait()
            pcall(function()
                local quest = GetCurrentQuest()
                EquipWeapon(getgenv().SelectWeapon)
                
                -- เช็คว่ามีเควสต์หรือยัง ถ้าไม่มีให้ไปรับเควสต์
                if not LocalPlayer.PlayerGui.Main.Quest.Visible then
                    LocalPlayer.Character.HumanoidRootPart.CFrame = quest.NPCCFrame
                    task.wait(0.5)
                    ReplicatedStorage.Remotes.CommF_:InvokeServer("StartQuest", quest.QuestName, quest.QuestLevel)
                else
                    -- วาร์ปไปตีมอนสเตอร์
                    for _, v in pairs(game.Workspace.Enemies:GetChildren()) do
                        if v.Name:find(quest.Monster) and v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 then
                            LocalPlayer.Character.HumanoidRootPart.CFrame = v.HumanoidRootPart.CFrame * CFrame.new(0, 10, 0)
                            AutoClick()
                            break
                        end
                    end
                end
            end)
        end
    end)
end)

